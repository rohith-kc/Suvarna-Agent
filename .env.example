# Copy to .env and fill in. Never commit .env.
# See CLAUDE.md Part 5.5 (LLM providers) and Part 5.7 (ElevenLabs) for what each variable is for.

# --- LLM provider selection (simulation harness) ---
LLM_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_AGENT=
LLM_MODEL_CUSTOMER=
LLM_MODEL_JUDGE=

# --- Rate limiting / cost guard ---
MAX_REQUESTS_PER_MINUTE=
MAX_REQUESTS_PER_DAY=
MAX_SIM_COST_USD=

# --- ElevenLabs (voice layer) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_UC1=
ELEVENLABS_AGENT_ID_UC2=
ELEVENLABS_WEBHOOK_SECRET=

# --- Tools server ---
TOOL_SECRET=
